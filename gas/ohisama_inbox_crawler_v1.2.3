  console.log(`uniqueAfterArticleKey=${allUnique.length}`);
  console.log(
    `articleKeyDedupRemoved=${allFingerprintUniqueCount - allUnique.length}`
  );
  console.log(`newAfterSeenState=${allNew.length}`);
  console.log(
    `elapsedTotal=${Date.now() - allStartedAt}ms`
  );
  console.log('========================================');
}


/**
 * Preview用の追加診断。
 * production filterと同系統の「子ページっぽいもの」を検出する。
 */
function previewLooksLikeGoogleNewsNoiseV122_(title) {
  let s = cleanText_(title || '');

  try {
    s = s.normalize('NFKC');
  } catch (e) {}

  return (
    /^画像・写真(?:\s*[|｜]|\s+)/i.test(s) ||
    /^関連写真\s*[|｜]/i.test(s) ||
    /^関連画像/i.test(s) ||
    /^（写真）/i.test(s) ||
    /^\(写真\)/i.test(s) ||
    /\[画像ギャラリー\s*\d+\s*\/\s*\d+\]/i.test(s) ||
    /画像一覧\s*[（(]\d+\s*\/\s*\d+[）)]/i.test(s) ||
    /\s\d+枚目(?:\s|-|$)/i.test(s)
  );
}


/**
 * 同一媒体・同一タイトルなのにFingerprintが複数ある群を検出。
 *
 * 公開時刻違い等で既存Fingerprintをすり抜ける
 * 「技術重複」候補を見るための診断専用。
 */
function previewSameHostTitleMultiFingerprintGroupsV122_(items) {
  const map = new Map();

  (items || []).forEach(raw => {
    const item = normalizeCandidate_(raw);

    if (!item || !isGoogleNewsUrl_(item.url)) {
      return;
    }

    const host =
      cleanText_(
        item.publisherHost ||
        makeGoogleNewsSourceKey_(
          item.publisher,
          item.sourceHomepage
        ) ||
        'unknown'
      ).toLowerCase();

    const titleKey =
      normalizeGoogleNewsTitleKey_(item.title);

    const key = `${host}|${titleKey}`;

    if (!map.has(key)) {
      map.set(key, []);
    }

    map.get(key).push(item);
  });

  return Array.from(map.values())
    .filter(group => {
      if (group.length < 2) return false;

      const fingerprints =
        new Set(group.map(x => x.fingerprint));

      return fingerprints.size > 1;
    })
    .sort((a, b) => b.length - a.length);
}
