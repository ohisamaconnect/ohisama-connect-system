{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohisamaconnect.com/member-voices/schemas/member_voices_extraction_v1_1.schema.json",
  "title": "MEMBER VOICES Extraction Artifact v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "extractor_version",
    "run_id",
    "source",
    "source_resolution",
    "meaning_units",
    "voice_candidates",
    "thread_candidates",
    "comparison_candidates",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1.1" },
    "contract_version": { "const": "1.0" },
    "extractor_version": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/sourceReference" },
    "source_resolution": { "$ref": "#/$defs/sourceResolution" },
    "meaning_units": {
      "type": "array",
      "items": { "$ref": "#/$defs/meaningUnit" }
    },
    "voice_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/voiceCandidate" }
    },
    "thread_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/threadCandidate" }
    },
    "comparison_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/comparisonCandidate" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_resolution": {
            "properties": { "gate_status": { "const": "BLOCK" } },
            "required": ["gate_status"]
          }
        }
      },
      "then": {
        "properties": {
          "meaning_units": { "maxItems": 0 },
          "voice_candidates": { "maxItems": 0 },
          "thread_candidates": { "maxItems": 0 },
          "comparison_candidates": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_resolution": {
            "properties": { "gate_status": { "const": "PASS" } },
            "required": ["gate_status"]
          }
        }
      },
      "then": {
        "properties": {
          "source_resolution": {
            "required": ["confirmed_speaker"],
            "properties": {
              "speaker_confirmed": { "const": true },
              "confirmed_speaker": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableString": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nativeLocator": {
      "type": "object",
      "additionalProperties": true,
      "required": ["article_id", "local_dir"],
      "properties": {
        "article_id": { "type": "string", "minLength": 1 },
        "author": { "$ref": "#/$defs/nullableString" },
        "published_at": { "$ref": "#/$defs/nullableString" },
        "local_dir": { "type": "string", "minLength": 1 },
        "original_url": { "$ref": "#/$defs/nullableString" },
        "text_hash": { "$ref": "#/$defs/nullableString" },
        "canonical_key": { "$ref": "#/$defs/nullableString" }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref_key",
        "source_system",
        "source_type",
        "source_native_id",
        "source_title",
        "author",
        "published_at",
        "original_url",
        "archive_reference",
        "text_reference",
        "locator_type",
        "native_locator",
        "text_hash",
        "attribution_type",
        "processing_status"
      ],
      "properties": {
        "source_ref_key": {
          "type": "string",
          "pattern": "^src_[0-9a-f]{24}$",
          "description": "Internal reference key only. Never a permanent source identity."
        },
        "source_system": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "source_native_id": { "$ref": "#/$defs/nullableString" },
        "source_title": { "$ref": "#/$defs/nullableString" },
        "publication": { "$ref": "#/$defs/nullableString" },
        "author": { "$ref": "#/$defs/nullableString" },
        "speakers": { "$ref": "#/$defs/stringArray" },
        "published_at": { "$ref": "#/$defs/nullableString" },
        "spoken_at": { "$ref": "#/$defs/nullableString" },
        "original_url": { "$ref": "#/$defs/nullableString" },
        "archive_reference": { "$ref": "#/$defs/nullableString" },
        "text_reference": { "$ref": "#/$defs/nullableString" },
        "locator_type": { "type": "string", "minLength": 1 },
        "native_locator": { "$ref": "#/$defs/nativeLocator" },
        "text_hash": { "$ref": "#/$defs/nullableString" },
        "attribution_type": { "$ref": "#/$defs/nullableString" },
        "processing_status": {
          "enum": ["DISCOVERED", "RESOLVED", "BLOCKED", "PROCESSED"]
        }
      }
    },
    "sourceResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_speaker",
        "metadata_author",
        "native_id_checked",
        "locator_checked",
        "author_checked",
        "speaker_confirmed",
        "confirmed_speaker",
        "gate_status",
        "block_reason",
        "decision_reason"
      ],
      "properties": {
        "expected_speaker": { "$ref": "#/$defs/nullableString" },
        "metadata_author": { "$ref": "#/$defs/nullableString" },
        "folder_member": { "$ref": "#/$defs/nullableString" },
        "native_id_checked": { "type": "boolean" },
        "locator_checked": { "type": "boolean" },
        "author_checked": { "type": "boolean" },
        "speaker_confirmed": { "type": "boolean" },
        "confirmed_speaker": { "$ref": "#/$defs/nullableString" },
        "gate_status": { "enum": ["PASS", "BLOCK"] },
        "block_reason": {
          "anyOf": [
            {
              "enum": [
                "SOURCE_NOT_FOUND",
                "METADATA_MISSING",
                "AUTHOR_MISSING",
                "NATIVE_LOCATOR_MISSING",
                "NATIVE_LOCATOR_MISMATCH",
                "LOCATOR_AUTHOR_CONFLICT",
                "SPEAKER_MISMATCH",
                "TEXT_REFERENCE_MISSING",
                "AMBIGUOUS_SOURCE",
                "UNSUPPORTED_SOURCE",
                "OTHER"
              ]
            },
            { "type": "null" }
          ]
        },
        "decision_reason": { "type": "string", "minLength": 1 }
      }
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator_type", "article_id", "text_reference"],
      "properties": {
        "locator_type": { "type": "string", "minLength": 1 },
        "article_id": { "type": "string", "minLength": 1 },
        "text_reference": { "type": "string", "minLength": 1 },
        "start_marker": { "$ref": "#/$defs/nullableString" },
        "end_marker": { "$ref": "#/$defs/nullableString" },
        "excerpt": { "$ref": "#/$defs/nullableString" }
      }
    },
    "referencedPeriod": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": { "$ref": "#/$defs/nullableString" },
            "end": { "$ref": "#/$defs/nullableString" },
            "label": { "$ref": "#/$defs/nullableString" }
          }
        }
      ]
    },
    "anchorReference": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "object_type", "label"],
          "properties": {
            "status": { "enum": ["CANONICAL", "PROVISIONAL"] },
            "object_system": { "$ref": "#/$defs/nullableString" },
            "object_type": { "type": "string", "minLength": 1 },
            "object_id": { "$ref": "#/$defs/nullableString" },
            "label": { "type": "string", "minLength": 1 },
            "evidence": { "$ref": "#/$defs/stringArray" }
          }
        }
      ]
    },
    "meaningUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaning_unit_id",
        "speaker",
        "source_locator",
        "central_proposition",
        "unit_type",
        "referenced_period",
        "candidate_categories",
        "candidate_primary_topic",
        "candidate_secondary_topics",
        "candidate_relations",
        "candidate_primary_anchor",
        "knowledge_value",
        "voice_eligible",
        "decision_reason"
      ],
      "properties": {
        "meaning_unit_id": {
          "type": "string",
          "pattern": "^mu_[0-9a-f]{24}$"
        },
        "speaker": { "type": "string", "minLength": 1 },
        "source_locator": { "$ref": "#/$defs/sourceLocator" },
        "central_proposition": { "type": "string", "minLength": 1 },
        "unit_type": { "$ref": "#/$defs/nullableString" },
        "referenced_period": { "$ref": "#/$defs/referencedPeriod" },
        "candidate_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "PATH",
              "SELF",
              "FEELING",
              "RELATIONSHIP",
              "GROUP",
              "EXPRESSION",
              "REFLECTION",
              "FUTURE",
              "BACKGROUND"
            ]
          }
        },
        "candidate_primary_topic": { "$ref": "#/$defs/nullableString" },
        "candidate_secondary_topics": { "$ref": "#/$defs/stringArray" },
        "candidate_relations": { "$ref": "#/$defs/stringArray" },
        "candidate_primary_anchor": { "$ref": "#/$defs/anchorReference" },
        "knowledge_value": { "$ref": "#/$defs/nullableString" },
        "voice_eligible": { "type": "boolean" },
        "decision_reason": { "type": "string", "minLength": 1 }
      }
    },
    "voiceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_key",
        "meaning_unit_references",
        "speaker",
        "title",
        "summary",
        "source_locator",
        "published_at",
        "spoken_at",
        "referenced_period",
        "temporal_perspective",
        "topic_categories",
        "primary_topic",
        "secondary_topics",
        "primary_anchor",
        "related_members",
        "related_songs",
        "related_lives",
        "related_events",
        "related_releases",
        "knowledge_value",
        "attribution",
        "candidate_decision",
        "decision_reason"
      ],
      "properties": {
        "candidate_key": {
          "type": "string",
          "pattern": "^vc_[0-9a-f]{24}$"
        },
        "meaning_unit_references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^mu_[0-9a-f]{24}$" }
        },
        "speaker": { "type": "string", "minLength": 1 },
        "title": { "$ref": "#/$defs/nullableString" },
        "summary": { "$ref": "#/$defs/nullableString" },
        "source_locator": { "$ref": "#/$defs/sourceLocator" },
        "published_at": { "$ref": "#/$defs/nullableString" },
        "spoken_at": { "$ref": "#/$defs/nullableString" },
        "referenced_period": { "$ref": "#/$defs/referencedPeriod" },
        "temporal_perspective": { "$ref": "#/$defs/nullableString" },
        "topic_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "PATH",
              "SELF",
              "FEELING",
              "RELATIONSHIP",
              "GROUP",
              "EXPRESSION",
              "REFLECTION",
              "FUTURE",
              "BACKGROUND"
            ]
          }
        },
        "primary_topic": { "$ref": "#/$defs/nullableString" },
        "secondary_topics": { "$ref": "#/$defs/stringArray" },
        "primary_anchor": { "$ref": "#/$defs/anchorReference" },
        "related_members": { "$ref": "#/$defs/stringArray" },
        "related_songs": { "$ref": "#/$defs/stringArray" },
        "related_lives": { "$ref": "#/$defs/stringArray" },
        "related_events": { "$ref": "#/$defs/stringArray" },
        "related_releases": { "$ref": "#/$defs/stringArray" },
        "knowledge_value": { "$ref": "#/$defs/nullableString" },
        "attribution": { "$ref": "#/$defs/nullableString" },
        "candidate_decision": { "enum": ["ACCEPT", "REJECT", "REVIEW"] },
        "decision_reason": { "type": "string", "minLength": 1 }
      }
    },
    "threadCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread_key",
        "thread_type",
        "natural_key",
        "speaker",
        "anchor",
        "normalized_primary_topic",
        "voice_candidate_keys",
        "formal_thread_ready",
        "decision_reason"
      ],
      "properties": {
        "thread_key": {
          "type": "string",
          "pattern": "^thr_[at]_[0-9a-f]{24}$"
        },
        "thread_type": { "enum": ["ANCHOR", "THEME"] },
        "natural_key": { "type": "string", "minLength": 1 },
        "speaker": { "type": "string", "minLength": 1 },
        "anchor": { "$ref": "#/$defs/anchorReference" },
        "normalized_primary_topic": { "$ref": "#/$defs/nullableString" },
        "voice_candidate_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^vc_[0-9a-f]{24}$" }
        },
        "formal_thread_ready": { "type": "boolean" },
        "decision_reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "thread_type": { "const": "ANCHOR" } } },
          "then": {
            "properties": {
              "anchor": {
                "not": { "type": "null" }
              },
              "normalized_primary_topic": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "thread_type": { "const": "THEME" } } },
          "then": {
            "properties": {
              "anchor": { "type": "null" },
              "normalized_primary_topic": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "comparisonCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_candidate_key",
        "thread_key",
        "prior_candidate_key",
        "current_candidate_key",
        "relation_to_prior",
        "difference_summary",
        "explicit_change_claimed",
        "comparison_confidence",
        "evidence"
      ],
      "properties": {
        "comparison_candidate_key": {
          "type": "string",
          "pattern": "^cmp_[0-9a-f]{24}$"
        },
        "thread_key": { "$ref": "#/$defs/nullableString" },
        "prior_candidate_key": {
          "type": "string",
          "pattern": "^vc_[0-9a-f]{24}$"
        },
        "current_candidate_key": {
          "type": "string",
          "pattern": "^vc_[0-9a-f]{24}$"
        },
        "relation_to_prior": {
          "enum": [
            "DUPLICATE",
            "CONSISTENT",
            "ELABORATION",
            "REFRAMING",
            "EXPLICIT_CHANGE",
            "TENSION",
            "UNCLEAR"
          ]
        },
        "difference_summary": { "type": "string", "minLength": 1 },
        "explicit_change_claimed": { "type": "boolean" },
        "comparison_confidence": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/stringArray" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "relation_to_prior": { "const": "EXPLICIT_CHANGE" } }
          },
          "then": {
            "properties": { "explicit_change_claimed": { "const": true } }
          }
        }
      ]
    }
  }
}
