{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohisamaconnect.com/member-voices/schemas/member_voices_provider_payload_v0_1.schema.json",
  "title": "MEMBER VOICES Provider Semantic Payload v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meaning_units",
    "voice_candidates",
    "thread_candidates",
    "comparison_candidates",
    "warnings"
  ],
  "properties": {
    "meaning_units": {
      "type": "array",
      "items": { "$ref": "#/$defs/providerMeaningUnit" }
    },
    "voice_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/providerVoiceCandidate" }
    },
    "thread_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/providerThreadCandidate" }
    },
    "comparison_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/providerComparisonCandidate" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "period": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["start", "end", "label"],
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] },
        "label": { "type": ["string", "null"] }
      }
    },
    "anchor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "status",
        "object_type",
        "object_id",
        "label",
        "evidence"
      ],
      "properties": {
        "status": { "enum": ["CANONICAL", "PROVISIONAL"] },
        "object_type": { "type": "string", "minLength": 1 },
        "object_id": { "type": ["string", "null"] },
        "label": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/stringArray" }
      }
    },
    "providerMeaningUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_ref",
        "evidence_excerpt",
        "start_marker",
        "end_marker",
        "central_proposition",
        "unit_type",
        "referenced_period",
        "candidate_categories",
        "candidate_primary_topic",
        "candidate_secondary_topics",
        "candidate_relations",
        "candidate_primary_anchor",
        "knowledge_value",
        "voice_eligible",
        "decision_reason"
      ],
      "properties": {
        "unit_ref": {
          "type": "string",
          "pattern": "^U[1-9][0-9]*$"
        },
        "evidence_excerpt": {
          "type": "string",
          "minLength": 1
        },
        "start_marker": { "type": ["string", "null"] },
        "end_marker": { "type": ["string", "null"] },
        "central_proposition": { "type": "string", "minLength": 1 },
        "unit_type": { "type": ["string", "null"] },
        "referenced_period": { "$ref": "#/$defs/period" },
        "candidate_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "PATH",
              "SELF",
              "FEELING",
              "RELATIONSHIP",
              "GROUP",
              "EXPRESSION",
              "REFLECTION",
              "FUTURE",
              "BACKGROUND"
            ]
          }
        },
        "candidate_primary_topic": { "type": ["string", "null"] },
        "candidate_secondary_topics": { "$ref": "#/$defs/stringArray" },
        "candidate_relations": { "$ref": "#/$defs/stringArray" },
        "candidate_primary_anchor": { "$ref": "#/$defs/anchor" },
        "knowledge_value": { "type": ["string", "null"] },
        "voice_eligible": { "type": "boolean" },
        "decision_reason": { "type": "string", "minLength": 1 }
      }
    },
    "providerVoiceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_ref",
        "meaning_unit_refs",
        "title",
        "summary",
        "referenced_period",
        "temporal_perspective",
        "topic_categories",
        "primary_topic",
        "secondary_topics",
        "primary_anchor",
        "related_members",
        "related_songs",
        "related_lives",
        "related_events",
        "related_releases",
        "knowledge_value",
        "attribution",
        "candidate_decision",
        "decision_reason"
      ],
      "properties": {
        "candidate_ref": {
          "type": "string",
          "pattern": "^V[1-9][0-9]*$"
        },
        "meaning_unit_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^U[1-9][0-9]*$"
          }
        },
        "title": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "referenced_period": { "$ref": "#/$defs/period" },
        "temporal_perspective": { "type": ["string", "null"] },
        "topic_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "PATH",
              "SELF",
              "FEELING",
              "RELATIONSHIP",
              "GROUP",
              "EXPRESSION",
              "REFLECTION",
              "FUTURE",
              "BACKGROUND"
            ]
          }
        },
        "primary_topic": { "type": ["string", "null"] },
        "secondary_topics": { "$ref": "#/$defs/stringArray" },
        "primary_anchor": { "$ref": "#/$defs/anchor" },
        "related_members": { "$ref": "#/$defs/stringArray" },
        "related_songs": { "$ref": "#/$defs/stringArray" },
        "related_lives": { "$ref": "#/$defs/stringArray" },
        "related_events": { "$ref": "#/$defs/stringArray" },
        "related_releases": { "$ref": "#/$defs/stringArray" },
        "knowledge_value": { "type": ["string", "null"] },
        "attribution": { "type": ["string", "null"] },
        "candidate_decision": {
          "enum": ["ACCEPT", "REJECT", "REVIEW"]
        },
        "decision_reason": { "type": "string", "minLength": 1 }
      }
    },
    "providerThreadCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thread_ref",
        "thread_type",
        "anchor",
        "normalized_primary_topic",
        "voice_candidate_refs",
        "formal_thread_ready",
        "decision_reason"
      ],
      "properties": {
        "thread_ref": {
          "type": "string",
          "pattern": "^T[1-9][0-9]*$"
        },
        "thread_type": { "enum": ["ANCHOR", "THEME"] },
        "anchor": { "$ref": "#/$defs/anchor" },
        "normalized_primary_topic": { "type": ["string", "null"] },
        "voice_candidate_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^V[1-9][0-9]*$"
          }
        },
        "formal_thread_ready": { "type": "boolean" },
        "decision_reason": { "type": "string", "minLength": 1 }
      }
    },
    "providerComparisonCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_ref",
        "thread_ref",
        "prior_candidate_ref",
        "current_candidate_ref",
        "relation_to_prior",
        "difference_summary",
        "explicit_change_claimed",
        "comparison_confidence",
        "evidence"
      ],
      "properties": {
        "comparison_ref": {
          "type": "string",
          "pattern": "^C[1-9][0-9]*$"
        },
        "thread_ref": {
          "type": ["string", "null"],
          "pattern": "^T[1-9][0-9]*$"
        },
        "prior_candidate_ref": {
          "type": "string",
          "pattern": "^V[1-9][0-9]*$"
        },
        "current_candidate_ref": {
          "type": "string",
          "pattern": "^V[1-9][0-9]*$"
        },
        "relation_to_prior": {
          "enum": [
            "DUPLICATE",
            "CONSISTENT",
            "ELABORATION",
            "REFRAMING",
            "EXPLICIT_CHANGE",
            "TENSION",
            "UNCLEAR"
          ]
        },
        "difference_summary": { "type": "string", "minLength": 1 },
        "explicit_change_claimed": { "type": "boolean" },
        "comparison_confidence": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/stringArray" }
      }
    }
  }
}