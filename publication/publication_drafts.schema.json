{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohisamaconnect.local/schema/publication-drafts-v1.0.json",
  "title": "OC-OS Publication Draft Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_key",
    "source_transcript_url",
    "generator_version",
    "generated_at",
    "drafts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "episode_key": {"type": "string", "minLength": 1},
    "source_transcript_url": {"type": "string"},
    "generator_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publication_key",
          "draft_key",
          "publication",
          "output_type",
          "platform",
          "title_candidates",
          "draft_text",
          "review_notes"
        ],
        "properties": {
          "publication_key": {"type": "string", "minLength": 1},
          "draft_key": {"type": "string", "minLength": 1},
          "publication": {"type": "string", "minLength": 1},
          "output_type": {
            "enum": ["トーク音声", "ショーノート", "SNS投稿", "オーディオグラム", "その他"]
          },
          "platform": {
            "enum": ["未定", "Spotify", "note", "X", "Instagram", "YouTube", "その他"]
          },
          "title_candidates": {
            "type": "array",
            "items": {"type": "string"},
            "maxItems": 10
          },
          "draft_text": {"type": "string"},
          "review_notes": {"type": "string"}
        }
      }
    }
  }
}
